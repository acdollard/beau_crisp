---
import Layout from "../../layouts/Layout.astro";
import { client } from "../../lib/sanity";

export async function getStaticPaths() {
  const posts = await client.fetch(`
    *[_type == "post"] {
      slug {
        current
      }
    }
  `);

  return posts.map((post: any) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;

const post = await client.fetch(
  `
  *[_type == "post" && slug.current == $slug][0] {
    title,
    publishedAt,
    mainImage {
      asset-> {
        _id,
        url
      }
    },
    body[] {
      ...,
      _type == "image" => {
        "url": asset->url
      }
    }
  }
`,
  { slug }
);

if (!post) {
  return Astro.redirect("/404");
}
---

<Layout title={`${post.title} - Beau Crisp Blog`}>
  <section class="bg-ebony pt-48 pb-16">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h1 class="text-4xl md:text-6xl font-customFont text-floralWhite leading-tight">
        {post.title}
      </h1>
      <time
        datetime={post.publishedAt}
        class="block mt-4 text-khaki font-condensed text-lg"
      >
        {new Date(post.publishedAt).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
    </div>
  </section>

  <article class="max-w-3xl mx-auto px-4 md:px-6 py-12">
    {
      post.mainImage && (
        <img
          src={post.mainImage.asset.url}
          alt={post.title}
          class="w-full h-64 object-cover rounded-sm mb-8"
        />
      )
    }

    <div class="prose lg:prose-xl max-w-none">
      {
        post.body?.map((block: any) => {
          if (block._type === "block") {
            return <p class="mb-4">{block.children[0].text}</p>;
          } else if (block._type === "image" && block.url) {
            return (
              <img
                src={block.url}
                alt="Blog content image"
                class="my-8 rounded-sm"
              />
            );
          }
        })
      }
    </div>
    <div class="flex justify-center mt-12">
      <a
        href="/writing"
        class="bg-ebony hover:bg-jet text-floralWhite px-6 py-3 transition-colors duration-200 shadow-lg font-condensed uppercase rounded-sm"
      >
        Back to Writing
      </a>
    </div>
  </article>
</Layout>
